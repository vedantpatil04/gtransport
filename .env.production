# Production build settings for the office console (`npm run build` / Vercel), loaded by Vite in
# production mode. Public values only: every VITE_* variable is embedded in the browser bundle, so
# nothing secret ever belongs here. A VITE_API_URL set in the Vercel project settings overrides it.
#
# The live console always talks to the production API — it never falls back to the prototype's
# sample data. Only `npm run build:demo` (demo mode, not this file) builds the sample-data demo.
VITE_API_URL=https://gtransport-7vgf.onrender.com
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
