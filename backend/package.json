{
  "name": "gangamata-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Gangamata Transport production API (NestJS modular monolith)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "db:seed:demo": "ts-node --transpile-only prisma/seed-demo.ts",
    "compliance:scan": "node dist/scripts/scan-expiry-events",
    "ai:worker": "node dist/scripts/run-ai-worker",
    "inbox:sync": "node dist/scripts/sync-inbox",
    "gps:cleanup": "node dist/scripts/cleanup-gps-history"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@prisma/adapter-pg": "~6.19.3",
    "@prisma/client": "~6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.28",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prisma": "~6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
