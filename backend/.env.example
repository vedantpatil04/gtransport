# Gangamata Transport — backend API configuration
# Copy to .env and adjust. Never commit .env (see .gitignore).
# Every variable below is validated at startup; the API refuses to boot on invalid values.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Set to true only when running behind a reverse proxy (Caddy/Nginx), so client IPs are correct.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Matches the docker-compose service at the repository root.
DATABASE_URL=postgresql://gangamata:gangamata@127.0.0.1:5433/gangamata?schema=public
DATABASE_POOL_MAX=10

# ── Authentication ────────────────────────────────────────────────────────────
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 15m | 12h | 7d
JWT_EXPIRES_IN=12h

# ── Receipt AI (server-side only; never exposed to the browser) ────────────────
# ollama (default) | dify
AI_PROVIDER=ollama
AI_REQUEST_TIMEOUT_MS=90000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4
# Required only when AI_PROVIDER=dify.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_APP_ID=

# ── File storage ──────────────────────────────────────────────────────────────
# Only "local" is implemented in Phase 0; Cloudflare R2 arrives with its adapter.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_ROOT=./storage

# ── Seed (optional; used by `npm run db:seed` only) ───────────────────────────
# Leave unset to skip creating a login. Minimum 12 characters.
# SEED_COMPANY_NAME=Gangamata Transport
# SEED_SUPER_ADMIN_EMAIL=
# SEED_SUPER_ADMIN_PASSWORD=
