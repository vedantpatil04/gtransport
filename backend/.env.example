# Gangamata Transport — backend API configuration
# Copy to .env and adjust for local development. Never commit .env (see .gitignore).
# Every variable below is validated at startup; the API refuses to boot on invalid values.

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
# Port to listen on. On Render, this is dynamically assigned via process.env.PORT.
PORT=3000
# Network interface to bind to (0.0.0.0 binds to all interfaces, required for Render).
HOST=0.0.0.0
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Set to true when running behind a reverse proxy (Render, Caddy, Nginx) so client IPs are correct.
TRUST_PROXY=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
# Local development default:
CORS_ORIGINS=http://localhost:5173
# Production example (point to your deployed Vercel domain):
# CORS_ORIGINS=https://gangamata-admin.vercel.app
# Note: Native mobile requests (Expo/React Native) do not send browser Origin headers and are permitted.
# Wildcard '*' is strictly forbidden in production.

# ── Database ──────────────────────────────────────────────────────────────────
# Local development matches the docker-compose service at the repository root:
DATABASE_URL=postgresql://gangamata:gangamata@127.0.0.1:5433/gangamata?schema=public
# Production: Use your remote PostgreSQL connection URL (e.g. Render Postgres, Neon, Supabase, AWS RDS):
# DATABASE_URL=postgresql://user:password@remote-db-host:5432/gangamata?sslmode=require
DATABASE_POOL_MAX=10

# ── Authentication ────────────────────────────────────────────────────────────
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In Render Blueprint (render.yaml), this can be auto-generated with `generateValue: true`.
JWT_SECRET=
# 15m | 12h | 7d
JWT_EXPIRES_IN=12h

# ── Receipt AI (server-side only; never exposed to the browser) ────────────────
# ollama (default) | dify
AI_PROVIDER=ollama
AI_REQUEST_TIMEOUT_MS=90000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4
# Required only when AI_PROVIDER=dify.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_APP_ID=

# ── File storage ──────────────────────────────────────────────────────────────
# Only "local" is implemented in Phase 0; Cloudflare R2 arrives with its adapter.
# On Render, local filesystem storage is ephemeral (/tmp/storage).
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_ROOT=./storage

# ── Seed (optional; used by `npm run db:seed` only) ───────────────────────────
# Leave unset to skip creating a login. Minimum 12 characters.
# SEED_COMPANY_NAME=Gangamata Transport
# SEED_SUPER_ADMIN_EMAIL=
# SEED_SUPER_ADMIN_PASSWORD=
