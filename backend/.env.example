# Gangamata Transport — backend API configuration
# Copy to .env and adjust for local development. Never commit .env (see .gitignore).
# Every variable below is validated at startup; the API refuses to boot on invalid values.

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
# Port to listen on. On Render, this is dynamically assigned via process.env.PORT.
PORT=3000
# Network interface to bind to (0.0.0.0 binds to all interfaces, required for Render).
HOST=0.0.0.0
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Set to true when running behind a reverse proxy (Render, Caddy, Nginx) so client IPs are correct.
TRUST_PROXY=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
# Local development default:
CORS_ORIGINS=http://localhost:5173
# Production example (point to your deployed Vercel domain):
# CORS_ORIGINS=https://gangamata-admin.vercel.app
# Note: Native mobile requests (Expo/React Native) do not send browser Origin headers and are permitted.
# Wildcard '*' is strictly forbidden in production.

# ── Database ──────────────────────────────────────────────────────────────────
# Local development matches the docker-compose service at the repository root:
DATABASE_URL=postgresql://gangamata:gangamata@127.0.0.1:5433/gangamata?schema=public
# Production: Use your remote PostgreSQL connection URL (e.g. Render Postgres, Neon, Supabase, AWS RDS):
# DATABASE_URL=postgresql://user:password@remote-db-host:5432/gangamata?sslmode=require
DATABASE_POOL_MAX=10

# ── Authentication ────────────────────────────────────────────────────────────
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In Render Blueprint (render.yaml), this can be auto-generated with `generateValue: true`.
JWT_SECRET=
# 15m | 12h | 7d
JWT_EXPIRES_IN=12h

# ── Receipt AI (server-side only; never exposed to the browser) ────────────────
# ollama (default) | dify
AI_PROVIDER=ollama
AI_REQUEST_TIMEOUT_MS=90000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4
# Required only when AI_PROVIDER=dify.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_APP_ID=

# ── Receipt reading queue ─────────────────────────────────────────────────────
# Jobs are rows in PostgreSQL, so nothing is lost across a restart or a redeploy.
# Set AI_WORKER_ENABLED=false to stop this process draining the queue — useful when a separate
# machine or a cron entry runs `npm run ai:worker` instead. The office screen says which of the
# two is in force, so a queue nobody is draining is visible rather than mysterious.
AI_WORKER_ENABLED=true
AI_WORKER_POLL_SECONDS=15
AI_WORKER_BATCH_SIZE=3
# Attempts per receipt before it stops retrying by itself; a person can always ask for another.
AI_MAX_ATTEMPTS=3
# Below this, an extraction is sent for closer review (NEEDS_REVIEW) rather than offered as ready to
# verify (SUCCEEDED). It never decides whether a record is authoritative — only a person does that.
AI_LOW_CONFIDENCE_THRESHOLD=0.6

# ── Receipt OCR (local, before the model) ──────────────────────────────────────
# auto (default): Tesseract runs on photographs and scanned PDFs when the host has it installed;
#   without it the vision model reads the image directly, and boot logs say so.
# tesseract: OCR is required — a receipt that needs OCR fails visibly until Tesseract is installed.
# none: OCR off. Digital PDFs are always read from their own text layer (Poppler), OCR or not.
# Install: Debian/Ubuntu `apt-get install tesseract-ocr` (+ `tesseract-ocr-hin` for eng+hin).
OCR_ENGINE=auto
OCR_LANGUAGES=eng
# OCR_TESSERACT_PATH=tesseract
OCR_TIMEOUT_MS=60000

# ── Company mailbox (server-side only; never exposed to the browser) ──────────
# none (default) contacts nothing and leaves the Inbox empty — which the screen states plainly,
# rather than showing an empty list that looks like an empty mailbox.
# gmail | microsoft_graph: the company's mailbox through the official API, connected by an
#   administrator from Admin → Inbox → Connect (OAuth consent, read-only scope). Recommended.
# imap: a mailbox on another host (Zoho, a hosting provider) with an app password.
# A dedicated company mailbox, never anyone's personal account.
EMAIL_PROVIDER=none
EMAIL_SYNC_ENABLED=false
EMAIL_SYNC_INTERVAL_MINUTES=15
# Messages per provider page, and pages per sync run.
EMAIL_SYNC_BATCH_SIZE=50
EMAIL_SYNC_MAX_PAGES=5
# How far back the first sync of a newly connected mailbox reaches.
EMAIL_INITIAL_SYNC_DAYS=30

# Required when EMAIL_PROVIDER=gmail or microsoft_graph.
# The API's callback, exactly as registered with Google / Microsoft:
EMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/inbox/oauth/callback
# Where the browser returns after consent (the admin console's Inbox page):
EMAIL_OAUTH_RETURN_URL=http://localhost:5173/admin/inbox
# 32 random bytes, base64 — encrypts mailbox tokens at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it means the mailbox has to be connected again. Never commit a real value.
EMAIL_TOKEN_ENCRYPTION_KEY=
# Gmail API: Google Cloud OAuth client (type "Web application"), Gmail API enabled,
# scope https://www.googleapis.com/auth/gmail.readonly.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Microsoft Graph: Entra app registration, delegated permissions Mail.Read + offline_access
# (+ User.Read), a client secret, and the company's tenant id.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=organizations

# Required when EMAIL_PROVIDER=imap. Use an app password, not the account's own password.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Larger attachments are recorded with a reason and left in the mailbox.
EMAIL_MAX_ATTACHMENT_MB=15
EMAIL_MAX_BODY_CHARS=20000
# Off leaves inbound mail unclassified. The mail is still filed and readable.
EMAIL_AI_ENABLED=true
# Below this the category is recorded but not applied, and no follow-up is suggested.
EMAIL_AI_MIN_CONFIDENCE=0.5
# Classification attempts per message (with backoff) before it is left FAILED for a manual retry.
EMAIL_AI_MAX_ATTEMPTS=3

# ── File storage ──────────────────────────────────────────────────────────────
# Only "local" is implemented in Phase 0; Cloudflare R2 arrives with its adapter.
# On Render, local filesystem storage is ephemeral (/tmp/storage).
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_ROOT=./storage

# ── Seed (optional; used by `npm run db:seed` only) ───────────────────────────
# Leave unset to skip creating a login. Minimum 12 characters.
# SEED_COMPANY_NAME=Gangamata Transport
# SEED_SUPER_ADMIN_EMAIL=
# SEED_SUPER_ADMIN_PASSWORD=
# Demo seed (npm run db:seed:demo) sign-in passwords — development only; the seed refuses production.
# SEED_DRIVER_PASSWORD=Driver123!
# SEED_STAFF_PASSWORD=Office123!

# ── Payouts (Phase 5) ─────────────────────────────────────────────────────────
# none: no online payouts; payments are recorded manually. razorpayx: send payouts via RazorpayX.
# Keys come from the RazorpayX dashboard (test keys start rzp_test_; live keys are refused
# outside NODE_ENV=production). They are used by the backend only — never ship them to a client.
PAYOUT_PROVIDER=none
# RAZORPAYX_BASE_URL=https://api.razorpay.com
# RAZORPAYX_KEY_ID=
# RAZORPAYX_KEY_SECRET=
# The RazorpayX business account number money is paid from (not a bank account of a payee).
# RAZORPAYX_ACCOUNT_NUMBER=
# Set when creating the webhook in the RazorpayX dashboard; used to verify X-Razorpay-Signature.
# RAZORPAYX_WEBHOOK_SECRET=

# ── Fleet location tracking (Phase 6) ─────────────────────────────────────────
# Operational thresholds rather than code constants: the office tunes these once real routes are
# running, with no release. Every value below is optional — the defaults shown are the agreed
# Gangamata policy, and the API refuses to start on a combination that cannot work (for example an
# offline window shorter than the stale window).

# Raw GPS history retention in days (driver_location_pings). Defaults to 7 days.
# Current driver positions (driver_location_states) are retained indefinitely.
# GPS_RAW_RETENTION_DAYS=7
# Whether in-process periodic cleanup of old raw GPS pings is active.
# GPS_RAW_CLEANUP_ENABLED=true
# Hours between raw GPS cleanup runs.
# GPS_RAW_CLEANUP_INTERVAL_HOURS=6
# Batch size for raw GPS ping deletion.
# GPS_RAW_CLEANUP_BATCH_SIZE=1000

# A driver whose newest fix is older than this is shown as falling behind rather than live.
# LOCATION_STALE_AFTER_MINUTES=15
# No contact of any kind within this window means the device is not reporting. Deliberately longer
# than the stale window: one missed fix is not an offline driver.
# LOCATION_OFFLINE_AFTER_MINUTES=30

# The stationary alert. A driver who stays within STATIONARY_RADIUS_METERS for longer than
# STATIONARY_DURATION_MINUTES raises an admin alert. 4 hours is the agreed policy.
# STATIONARY_RADIUS_METERS=150
# STATIONARY_DURATION_MINUTES=240
# Fixes less accurate than this take no part in the stationary decision — comparing a fix with a
# wider error radius than the geofence itself would invent movement, or conceal it.
# STATIONARY_MAX_ACCURACY_METERS=200

# Ingestion guards. A fix worse than LOCATION_MAX_ACCURACY_METERS is not stored at all; one from
# further ahead than the clock-skew allowance is refused, so a wrong device clock cannot pin itself
# to the top of every "latest fix" comparison.
# LOCATION_MAX_ACCURACY_METERS=2000
# LOCATION_MAX_CLOCK_SKEW_MINUTES=10
# How far back a fix buffered offline may be and still be accepted when signal returns.
# LOCATION_MAX_BACKLOG_HOURS=72
# Per-driver ceiling. Generous for normal tracking; low enough to stop a device in a retry loop.
# LOCATION_MAX_FIXES_PER_MINUTE=120

# The reporting strategy served to the driver app, so it is tunable without shipping a build.
# LOCATION_TRACKING_INTERVAL=60
# Longer while stationary, because a parked truck is not news — and it spares the battery.
# LOCATION_TRACKING_STATIONARY_INTERVAL=900
# LOCATION_TRACKING_DISTANCE=150
# Fixes the phone may hold while out of signal before the oldest are dropped.
# LOCATION_DEVICE_BUFFER_LIMIT=1000
# LOCATION_MAX_BATCH_SIZE=100

# How often the admin Live Fleet screen polls, in seconds.
# FLEET_REFRESH_INTERVAL=30

# ── File storage (Cloudinary = ACTIVE; R2 = FUTURE) ───────────────────────────
# Active storage provider: `cloudinary` (default) or `local`. Cloudflare R2 is the future provider.
# FILE_STORAGE_PROVIDER=cloudinary
# FILE_STORAGE_LOCAL_ROOT=./storage
# Cloudinary credentials (server-side only; never exposed to browser or mobile apps):
# CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# CLOUDINARY_FOLDER=gangamata

