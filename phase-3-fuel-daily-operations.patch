+                  ))}
+                </tbody>
+              </Table>
+              {rows.length === 0 && <p className="px-4 py-12 text-center text-sm text-muted-foreground">{t('admin.opsApi.empty')}</p>}
+              {(pageIndex > 0 || nextCursor) && (
+                <div className="flex items-center justify-end gap-2 border-t px-4 py-3">
