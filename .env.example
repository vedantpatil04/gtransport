# Gangamata Transport — Frontend Environment Variables (Example)
# Copy to .env and adjust as needed. Never commit .env.

# API Base URL:
# - Leave unset to run in client-side prototype demo mode.
# - Set to http://localhost:3000 for local development against the NestJS backend.
# - Set to your Render staging/production URL (e.g. https://<render-service>.onrender.com) for production.
VITE_API_URL=http://localhost:3000

# ── Map provider (Phase 6) ────────────────────────────────────────────────────
# Live Fleet draws on the built-in vector map of the operating region
# (Maharashtra–Karnataka–Goa), rendered from real coordinates. It needs no tile service and no
# API key, so there is no map secret to configure or to leak.
#
# This variable exists so a deployment can be pointed at a different implementation without a code
# change. Only "vector" is implemented today; any other value falls back to it with a warning
# rather than leaving a blank panel. If a hosted provider is ever added, its key belongs in the
# backend and must be proxied — never in a VITE_* variable, which is embedded in the bundle
# and readable by anyone who loads the page.
# VITE_MAP_PROVIDER=vector
