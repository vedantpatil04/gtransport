# Gangamata Transport — Mobile App Configuration (Expo / React Native)
# Copy to .env (or .env.local) for local development. Never commit .env.
# IMPORTANT: Never place secrets, API keys, or private tokens in EXPO_PUBLIC_* variables.
# EXPO_PUBLIC_* variables are embedded into client bundle code during build.

# ── API Base URL ──────────────────────────────────────────────────────────────
# Android Studio Emulator:
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Physical Android / iOS device over local Wi-Fi (use your PC's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
# (Place non-EXPO_PUBLIC vars such as REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.100 in .env.local)

# Render Staging:
# EXPO_PUBLIC_API_URL=https://gangamata-backend.onrender.com

# Production:
# EXPO_PUBLIC_API_URL=https://api.gangamatatransport.com

# ── App Environment ───────────────────────────────────────────────────────────
# development | staging | production (drives non-secret behaviour like logging)
EXPO_PUBLIC_APP_ENV=development

# ── Location tracking (Phase 6) ───────────────────────────────────────────────
# Nothing to configure here on purpose. How often the app reports, how far apart the fixes are and
# how many it may buffer offline all come from the API (GET /locations/tracking-policy), so the
# office can tune tracking without shipping a new build to every driver's phone.
#
# Background location does require a development build rather than Expo Go, because it uses native
# modules: run `npm run android` (or `expo run:android --device`) after installing dependencies.
