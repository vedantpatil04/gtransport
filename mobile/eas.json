{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://gtransport-7vgf.onrender.com",
        "EXPO_PUBLIC_ADMIN_WEB_URL": "https://gtransportt.vercel.app"
      }
    },
    "client-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://gtransport-7vgf.onrender.com",
        "EXPO_PUBLIC_ADMIN_WEB_URL": "https://gtransportt.vercel.app"
      }
    }
  }
}
